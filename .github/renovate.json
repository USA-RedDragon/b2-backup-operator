{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>USA-RedDragon/renovate-configs",
        "local>USA-RedDragon/renovate-configs:golang"
    ],
    "ignorePaths": ["**/node_modules/**", "**/vendor/**", "**/test/**", "**/tests/**", "**/__tests__/**", "**/__fixtures__/**", "**/testdata/**"],
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)Makefile$/"],
            "matchStrings": ["KUSTOMIZE_VERSION \\?= (?<currentValue>v\\S+)"],
            "datasourceTemplate": "go",
            "depNameTemplate": "sigs.k8s.io/kustomize/kustomize/v5"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)Makefile$/"],
            "matchStrings": ["CONTROLLER_TOOLS_VERSION \\?= (?<currentValue>v\\S+)"],
            "datasourceTemplate": "go",
            "depNameTemplate": "sigs.k8s.io/controller-tools"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)Makefile$/", "/(^|/)\\.custom-gcl\\.yml$/"],
            "matchStrings": [
                "GOLANGCI_LINT_VERSION \\?= (?<currentValue>v\\S+)",
                "(?:^|\\n)version: (?<currentValue>v\\S+)"
            ],
            "datasourceTemplate": "go",
            "depNameTemplate": "github.com/golangci/golangci-lint/v2"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)\\.custom-gcl\\.yml$/"],
            "matchStrings": ["module: \"?(?<depName>sigs\\.k8s\\.io/logtools)\"?\\n(?:.*\\n)*?\\s+version: (?<currentValue>v\\S+)"],
            "datasourceTemplate": "go"
        },
        {
            "customType": "regex",
            "managerFilePatterns": ["/(^|/)internal/backup/cronjob\\.go$/"],
            "matchStrings": ["DefaultImage = \"(?<depName>[^\":@]+):(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""],
            "datasourceTemplate": "docker",
            "autoReplaceStringTemplate": "DefaultImage = \"{{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}\""
        }
    ],
    "packageRules": [
        {
            "matchPackageNames": ["github.com/golangci/golangci-lint/v2"],
            "groupName": "golangci-lint"
        }
    ]
}
